{
    "name": "anubit/typo3-paint",
    "type": "typo3-cms-extension",
    "description": "Configurable backend colors (primary, secondary, icon accent, header, sidebar) for the TYPO3 backend",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Anu Bhuvanendran Nair",
            "role": "Developer"
        }
    ],
    "require": {
        "typo3/cms-core": "^14.3",
        "typo3/cms-backend": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "AnuBit\\Typo3Paint\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "typo3_paint"
        }
    }
}
